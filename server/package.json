  "dependencies": {
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

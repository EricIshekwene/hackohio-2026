ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# /api/extract pauses (429, client shows "type it in") once total AI spend reaches this (USD)
SPEND_LIMIT_USD=30
# Per-visitor cap on /api/extract calls (429 past it, client falls back to typing)
EXTRACT_PER_IP_PER_HOUR=30
# Proxy hops in front of the server (1 on Railway/Render); 0 when exposed directly
TRUST_PROXY=1
